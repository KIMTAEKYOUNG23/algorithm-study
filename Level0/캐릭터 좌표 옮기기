#include <string>
#include <vector>
using namespace std;

vector<int> solution(vector<string> keyinput, vector<int> board) {
    vector<int> answer;
    int x = 0, y = 0;

    for(int i=0; i<keyinput.size(); i++){
        if(keyinput[i]=="left")  x--;
        if(keyinput[i]=="right") x++;
        if(keyinput[i]=="up")    y++;
        if(keyinput[i]=="down")  y--;

        if(abs(x) > board[0]/2){
            if(x>0) x =  board[0]/2;
            else    x = -board[0]/2;
        }
        if(abs(y) > board[1]/2){
            if(y>0) y =  board[1]/2;
            else    y = -board[1]/2;
        }
    }

    answer.push_back(x);
    answer.push_back(y);
    return answer;
}
