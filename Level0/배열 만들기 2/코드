#include <string>
#include <vector>

using namespace std;

vector<int> solution(int l, int r) {
    vector<int> answer;
   while(l<=r){
        int n=l;
        while(n>0){
            int digit = n%10;
            if(digit%5==0){
                if(n<10){
                    answer.push_back(l);
                    break;
                }
                else {n/=10; continue;}
            }
            else break;
        }
        l++;
    }
    if(answer.empty()){
        answer.push_back(-1);
    } 
    return answer;
}
