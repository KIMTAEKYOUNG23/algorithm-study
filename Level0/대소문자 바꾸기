#include <stdio.h>
#include <string.h>
#define LEN_INPUT 21

int main(void) {
    char s1[LEN_INPUT];
    scanf("%s", s1);
    for(int i=0; i<strlen(s1); i++){
        if(s1[i]>='a'&&s1[i]<='z'){
            s1[i]=s1[i]-32;
        }
        else{s1[i]=s1[i]+32;}
    }
    printf("%s\n", s1);
    return 0;
}
