#include <string>
#include <vector>

using namespace std;

int solution(int a, int b) {
    int answer = 0;
    for(int i=a;i>1;i--){
        if(a%i==0&&b%i==0){
            a/=i;
            b/=i;
        }
    }
    while(b%2==0) b/=2;
    while(b%5==0) b/=5;
    
    if(b==1){
        answer = 1;
    }
    else{
        answer = 2;
    }
    
    return answer;
}
// 최대공약수를 찾아 기약분수로 만든후 b에 2와5가 소인수로 있는지 여부 판단후 answer값 배출
